<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>List</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <%- include('nav') %>

  <div class="list-container">
    <h1>Task List</h1>

    <% if (result.length > 0) { %>
      <% result.forEach(task => { %>
        <div class="task-card">
          <h3><%= task.title %></h3>
          <p><%= task.description %></p>
          <a href="/delete/<%= task._id %>">Delete</a>
          <a href="/update/<%= task._id %>">Update</a>
        </div>
      <% }) %>
    <% } else { %>
      <p class="no-task">No tasks available</p>
    <% } %>
   
  </div>
</body>
</html>
